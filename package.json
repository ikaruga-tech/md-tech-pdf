{
  "name": "md-tech-pdf",
  "version": "0.1.0",
  "description": "Technical document PDF generator from Markdown with flexible diagram layout",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "md-tech-pdf": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:mermaid": "tsx tools/test-mermaid.ts",
    "dev:html": "tsx tools/test-html.ts",
    "dev:pdf": "tsx tools/test-pdf.ts",
    "dev:plantuml": "tsx tools/test-plantuml.ts"
  },
  "keywords": [
    "markdown",
    "pdf",
    "technical-writing",
    "diagrams",
    "mermaid",
    "plantuml"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "commander": "^15.0.0",
    "markdown-it": "^15.0.1",
    "playwright": "^1.63.0",
    "yaml": "^2.9.0"
  }
}
