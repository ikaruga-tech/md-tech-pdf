{
  "name": "md-tech-pdf",
  "displayName": "md-tech-pdf",
  "description": "Export technical Markdown documents to PDF with Mermaid and PlantUML support.",
  "version": "0.5.0",
  "publisher": "ikaruga-tech",
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikaruga-tech/md-tech-pdf.git"
  },
  "homepage": "https://github.com/ikaruga-tech/md-tech-pdf#readme",
  "bugs": {
    "url": "https://github.com/ikaruga-tech/md-tech-pdf/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "mermaid",
    "plantuml",
    "diagram",
    "export",
    "documentation",
    "technical-document"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "md-tech-pdf.openPreview",
        "title": "md-tech-pdf: Open Preview",
        "shortTitle": "Open Preview",
        "icon": {
          "light": "./media/preview-light.svg",
          "dark": "./media/preview-dark.svg"
        }
      },
      {
        "command": "md-tech-pdf.exportPdf",
        "title": "md-tech-pdf: Export to PDF",
        "shortTitle": "Export to PDF",
        "icon": {
          "light": "./media/export-light.svg",
          "dark": "./media/export-dark.svg"
        }
      },
      {
        "command": "md-tech-pdf.exportPdfAs",
        "title": "md-tech-pdf: Export to PDF As..."
      },
      {
        "command": "md-tech-pdf.clearDiagramCache",
        "title": "md-tech-pdf: Clear Diagram Cache"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "md-tech-pdf.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "md-tech-pdf.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@90"
        },
        {
          "command": "md-tech-pdf.exportPdf",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "md-tech-pdf",
      "properties": {
        "md-tech-pdf.plantuml.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Path to the Java executable used by PlantUML."
        },
        "md-tech-pdf.plantuml.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the local PlantUML JAR file."
        },
        "md-tech-pdf.export.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Default output directory for Export to PDF. Leave empty to use the Markdown file directory."
        },
        "md-tech-pdf.export.afterExport": {
          "type": "string",
          "enum": [
            "none",
            "open",
            "reveal"
          ],
          "default": "none",
          "description": "Action to perform automatically after a successful PDF export."
        },
        "md-tech-pdf.preview.refresh": {
          "type": "string",
          "enum": [
            "manual",
            "onSave",
            "onType"
          ],
          "default": "onSave",
          "description": "Controls when an open md-tech-pdf preview is refreshed."
        },
        "md-tech-pdf.preview.debounceDelay": {
          "type": "integer",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "Debounce delay in milliseconds before refreshing the preview when preview.refresh is set to onType (minimum: 100ms, default: 500ms)."
        },
        "md-tech-pdf.preview.cache.persistent": {
          "type": "boolean",
          "default": true,
          "description": "Enable persistent disk caching for rendered Mermaid and PlantUML diagrams across VS Code sessions."
        },
        "md-tech-pdf.preview.scrollSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Initial scroll synchronization state between editor and preview."
        },
        "md-tech-pdf.preview.scrollSync.behavior": {
          "type": "string",
          "enum": [
            "smooth",
            "instant"
          ],
          "default": "smooth",
          "description": "Scroll animation behavior when synchronizing scroll position with editor."
        },
        "md-tech-pdf.preview.scrollSync.delay": {
          "type": "integer",
          "enum": [
            0,
            20,
            50,
            100
          ],
          "default": 50,
          "description": "Debounce delay in milliseconds for scroll synchronization between editor and preview."
        },
        "md-tech-pdf.preview.zoom": {
          "type": "string",
          "enum": [
            "fit",
            "50%",
            "75%",
            "100%",
            "125%",
            "150%"
          ],
          "default": "fit",
          "description": "Initial zoom magnification level for the preview display."
        },
        "md-tech-pdf.styles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of custom CSS file paths (relative to workspace or document) to apply to preview and PDF export."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "compile:tests": "tsc -p tsconfig.test.json",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest:unit": "npm run compile:tests",
    "test:unit": "mocha 'out/test/unit/**/*.test.js'",
    "pretest:extension": "npm run build && npm run compile:tests",
    "test:extension": "vscode-test",
    "pretest": "npm run build && npm run compile:tests",
    "test": "npm run test:unit && npm run test:extension",
    "package:vsix": "vsce package"
  },
  "dependencies": {
    "md-tech-pdf": "file:../md-tech-pdf-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.8.0"
  }
}
